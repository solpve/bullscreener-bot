# Copy to bot/.env (gitignored). Existing shell env vars always win over this file.

# Solana RPC. Defaults to constants.endpoints.defaultRpc (public mainnet-beta,
# which rate-limits heavy calls). Point at a paid endpoint before going live.
RPC_URL=https://api.mainnet-beta.solana.com

# Path to the BULL wallet keypair (JSON byte array, e.g. ../keys/bull.json).
# LEAVE THIS UNSET to force DRY_RUN on. The file is never read except to sign;
# its contents are never logged.
# KEYPAIR_PATH=/absolute/path/to/keys/bull.json

# "false" goes live. Anything else (or unset) stays in dry run.
DRY_RUN=true

# Only used by `npm run rebates -- --send`, and only if the rebate policy in
# config/constants.json is ever re-enabled. Never needed by the keeper loop.
# OPS_KEYPAIR_PATH=/absolute/path/to/keys/ops.json

# Optional Jupiter portal key (free tier). Raises the 60 req/min limit.
# JUPITER_API_KEY=

# debug | info | warn | error
LOG_LEVEL=info
