# Copy to .env.local. Never commit the filled-in file.

# Solana JSON-RPC endpoint. Optional — defaults to endpoints.defaultRpc in
# config/constants.json (the public mainnet-beta node), which rate-limits
# getProgramAccounts hard. A dedicated endpoint is strongly recommended in prod.
RPC_URL=

# Enables the holders criterion via getProgramAccountsV2. Optional.
# Without it every coin's holders check renders "unverified" — never estimated,
# and an unverified check is never scored as a pass, so nothing reaches
# "Listed" until this is set.
HELIUS_API_KEY=

# ADDRESS EMBARGO. Must stay unset (or anything other than "true") until the
# v0 launch gates in x-TODO.md are closed.
#
# The BULL deposit address is a one-way door: it gets irreversibly baked into
# every participating coin's fee-sharing config, so it is published exactly
# once. While this is off, every place the address would appear renders
# "deposit address reveals at launch" instead, and /api/v1/tokens masks our
# shareholder entries.
#
# This is inlined at build time — flipping it requires a rebuild, not a restart.
NEXT_PUBLIC_SHOW_ADDRESS=false

